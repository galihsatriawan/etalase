# Copy to .env. Everything is optional: missing values fall back to offline / mock mode.
# Keep comments on their own lines: text after a value would become part of the value.

# dev enables /dev simulation endpoints; use prod for real traffic
ETALASE_ENV=dev
PUBLIC_BASE_URL=http://localhost:8080
SESSION_SECRET=change-me-to-a-long-random-string
# Required on any non-localhost URL (the app refuses to start without them):
# X-Dev-Token header for /dev/* (dev mode only)
DEV_TOKEN=
# ?token=... for shipping webhook, mock payment webhook, /tasks/expire
WEBHOOK_TOKEN=
# Header X-Etalase-Operator-Token for the endpoints that move money by hand (/tasks/disputes, /tasks/resolve-dispute).
# A different secret from WEBHOOK_TOKEN on purpose: that one sits in the Biteship webhook URL and so in access logs.
OPERATOR_TOKEN=
# Proxy addresses at the end of X-Forwarded-For after the client's own: 0 on Cloud Run alone, 1 behind a load balancer or Cloudflare
TRUSTED_PROXY_HOPS=0
# en | id
SELLER_LOCALE=en
# memory | firestore
STORE_BACKEND=memory

# Payout hold = the buyer's return window after the courier confirms delivery. 0 pays at once and switches returns off.
PAYOUT_HOLD_HOURS=72
# Sellers with fewer than NEW_SELLER_ORDERS completed orders wait this long instead
NEW_SELLER_HOLD_HOURS=168
NEW_SELLER_ORDERS=5
# A return the seller does not answer in this many hours counts as approved
RETURN_SELLER_RESPONSE_HOURS=48
# An approved return that has not reached the seller after this many days lapses
RETURN_LAPSE_DAYS=7
# A parcel still marked shipped is asked about again this often, so a lost courier webhook never leaves money stuck
SHIPMENT_RECHECK_HOURS=6
# Where to write to ask for a second look at an operator's dispute decision (an email address or a WhatsApp link). The public
# payout policy (/policy/payouts) offers an appeal only when this is set. Set it before real money moves.
SUPPORT_CONTACT=
DISPUTE_APPEAL_DAYS=7

# Gemini: either Vertex AI (recommended on Google Cloud) or an API key
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GEMINI_API_KEY is accepted as an alternative name
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=etalase-dev-verify
WHATSAPP_APP_SECRET=

# Telegram bot, an optional second seller channel (SETUP.md section 3b). The secret: 16+ characters from A-Z a-z 0-9 _ -
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Shop addresses <slug>.<STORE_BASE_DOMAIN> instead of /stores/<id> (SETUP.md section 7). A bare host; needs wildcard DNS and certificate
STORE_BASE_DOMAIN=

# UCP Order capability (docs/16-ucp.md, ADR 0011). Order webhooks go only to platforms listed here: a JSON list of profile URLs, or of
# {"profile": "...", "webhook_hosts": ["..."]}. Empty: the order can be read, nothing is pushed. With platforms listed outside dev,
# UCP_SIGNING_KEY is required: a PEM private key (EC P-256 or Ed25519) whose public half is published in /.well-known/ucp as signing_keys.
UCP_PLATFORMS=
UCP_SIGNING_KEY=
# Sandbox only, for the official conformance suite (python -m ucp_conformance.run --mode test). Refused outside dev, with real adapters,
# or with a secret under 16 characters. Never set these on a real deployment.
UCP_TEST_MODE=false
UCP_SIMULATION_SECRET=

# Sign-up in chat (SETUP.md section 7b): anyone who writes to the Etalase number can start a shop. Off by default. A new shop is
# invisible until it is verified (mock payment: at once; a real provider: an operator calls POST /tasks/verify-seller, which needs OPERATOR_TOKEN).
SIGNUP_ENABLED=false
SIGNUP_SHOPS_PER_HOUR=20
SIGNUP_HOLD_HOURS=72

# Instagram API with Instagram Login (optional catalog import)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Xendit (test-mode keys for the hackathon)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Biteship
BITESHIP_API_KEY=

# Business rules
COMMISSION_RATE=0.04
RESERVATION_TTL_MINUTES=15
MAX_QTY_PER_ORDER=10
MAX_CHECKOUTS_PER_BUYER_PER_HOUR=5
# Gemini calls one seller can trigger per hour (only counted when Gemini is on)
SELLER_AI_CALLS_PER_HOUR=60
